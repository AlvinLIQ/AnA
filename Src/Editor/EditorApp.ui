<PageView Name="pageView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <StackPanel ControlSize="0.0f, 0.0f" Spacing="0.01f" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
        Color="0.156f, 0.156f, 0.156f, 1.0f" Padding="0.05f, 0.01f, 0.05f, 0.01f">
        <TextBlock Text="Editor" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <Button HorizontalAlignment="Start" Click="loadModelButton_Click">
            <TextBlock Text="Load Model" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </Button>
        <Button HorizontalAlignment="Start" Click="saveSceneButton_Click">
            <TextBlock Text="Save Scene" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </Button>
        <TextBlock Text="Meshes" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <ObjectView Name="modelList" Orientation="Vertical" HorizontalAlignment="Stretch" RenderMode="Passive" Color="0.2f, 0.2f, 0.2, 1.0f"/>
        <TextBlock Text="Near" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <Slider Name="nearSlider" HorizontalAlignment="Stretch" ControlSize="0.0f, 0.02f" Value="0.0f"/>
        <TextBlock Text="Far" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <Slider Name="farSlider" HorizontalAlignment="Stretch" ControlSize="0.0f, 0.02f" Value="1.0f"/>
        <TextBlock Text="Light Direction" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <Slider Name="lightX" HorizontalAlignment="Stretch" ControlSize="0.0f, 0.02f" Value="0.24f"/>
        <Slider Name="lightY" HorizontalAlignment="Stretch" ControlSize="0.0f, 0.02f" Value="0.9f"/>
        <Slider Name="lightZ" HorizontalAlignment="Stretch" ControlSize="0.0f, 0.02f" Value="0.3f"/>
        <TextBlock Text="Lock Camera" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        <ToggleSwitch Name="camLockToggle" ControlSize="0.04f, 0.02f"/>
        <ListView Orientation="Horizontal" HorizontalAlignment="Start" RenderMode="Passive" ControlSize="0.f, 40.0f" Color="0.2f, 0.2f, 0.2f, 1.0f" Spacing="0.01f">
            <TextBlock Text="t1" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
            <TextBlock Text="t2" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
            <TextBlock Text="t3" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </ListView>
        <Button HorizontalAlignment="Start" Click="exitButton_Click">
            <TextBlock Text="Exit" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </Button>
        <Button Click="pageButton_Click">
            <TextBlock Text="Test" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </Button>
    </StackPanel>
    <StackPanel ControlSize="0.0f, 0.0f" Spacing="0.01f" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
        Color="0.156f, 0.156f, 0.156f, 1.0f" Padding="0.05f, 0.01f, 0.05f, 0.01f">
        <TextBox Text="123"/>
        <Button Click="pageButton_Click">
            <TextBlock Text="Back" FontColor="0.8f, 0.8f, 0.8f, 1.0f"/>
        </Button>
    </StackPanel>
</PageView>
