#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"
#include "bindings.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = CULL_MODE_ID) const int CullMode = 0;

layout(scalar, set = DEFAULT_VERTEX_LAYOUT, binding = BIND_VERTEX) buffer VertexSSBO
{
    Vertex vertices[];
};

layout(scalar, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT) buffer ObjectSSBO
{
    Object objects[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_COUNT) buffer countBuffer
{
    uint objectCount;
    uint collidedCount;
    uint meshletCount;
};

layout(scalar, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_COLLISION) buffer collisionBuffer
{
    CollisionData collisions[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_MESHLET_ID) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_MESHLET_ID_COUNT) buffer MeshletIDCountSSBO
{
    uint meshletIDCount;
};

layout(set = DEFAULT_UBO_LAYOUT, binding = BIND_CAMERA) buffer CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = DEFAULT_UBO_LAYOUT, binding = BIND_FRUSTUM) uniform Frustum
{
    vec4 planes[6];
} frustum;

layout(std430, set = DEFAULT_MESHLET_LAYOUT, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(std430, set = DEFAULT_MESHLET_LAYOUT, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(set = DEFAULT_MESHLET_LAYOUT, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

layout(std430, set = DEFAULT_MESHLET_LAYOUT, binding = 3) buffer meshletCullingSSBO
{
    BoundingSphere boundings[];
} mcsbo;

taskPayloadSharedEXT MeshPayload taskData;
shared uint visibleCount;

bool isMeshletVisible(uint meshletID, uint objectID)
{
    if (meshletID > meshletCount || objectID > objectCount)
        return false;
    Meshlet meshlet = meshlets[meshletID];
    BoundingSphere boundingSphere = mcsbo.boundings[meshletID];
    mat4 transform = objects[objectID].transform;
    vec3 center = (transform * vec4(boundingSphere.center, 1.0)).xyz;
    float scale = max(length(transform[0].xyz), max(length(transform[1].xyz), length(transform[2].xyz)));
    float radius = boundingSphere.radius * scale;

    vec3 normal = mat3(transform) * boundingSphere.normal;
    float len = length(normal);
    if (len != 0.)
        normal /= len;
    vec3 coneApex = (transform * vec4(boundingSphere.coneApex, 1.0)).xyz;

    if (((CullMode & CULL_FRUSTUM) != 0 && !isSphereInsideFrustum(center, radius, frustum.planes)) ||
            ((CullMode & CULL_BACKFACE) != 0 && !isMeshletFacingCamera(cbo.position.xyz, coneApex, normal, boundingSphere.cutoff)))
        return false;

    return true;
}

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    visibleCount = 0;
    barrier();

    if (globalID < meshletIDCount)
    {
        bool visible = CullMode == 0 || isMeshletVisible(meshletIDs[globalID].meshletID, meshletIDs[globalID].objectID); //meshletIDs[globalID << 1], meshletIDs[(globalID << 1) ^ 1]);

        if (visible)
        {
            uint index = atomicAdd(visibleCount, 1);
            taskData.visibleIndices[index] = globalID;
        }

        taskData.visibleCount = visibleCount;
    }
    barrier();
    EmitMeshTasksEXT(visibleCount, 1, 1);
}
