#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_buffer_reference: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"
#include "bindings.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = CULL_MODE_ID) const int CullMode = 0;

layout(scalar, buffer_reference) buffer VertexRef
{
    Vertex vertices[];
};

layout(scalar, buffer_reference) buffer MeshletVertexRef
{
    uint vertices[];
};

layout(scalar, buffer_reference) buffer MeshletIndexRef
{
    uint8_t indices[];
};

struct Meshlet2
{
    uint vertexOffset;
    uint indexOffset;
    uint vertexCount;
    uint indexCount;
    BoundingSphere bounding;
};

layout(scalar, buffer_reference) buffer MeshletRef
{
    Meshlet2 meshlets[];
};

struct Mesh
{
    vec3 center;
    float radius;
    vec4 halfVolume;
    mat4 transform;
    uint textureId;
    VertexRef vertexPtr;
    MeshletVertexRef meshletVertexPtr;
    MeshletIndexRef meshletIndexPtr;
};

layout(scalar, buffer_reference) buffer MeshRef
{
    Mesh meshes[];
};

struct MeshletID2
{
    uint meshletID;
    uint meshID;
};

layout(scalar, buffer_reference) buffer MeshletIDRef
{
    MeshletID2 ids[];
};

layout(scalar, buffer_reference) buffer MiscRef
{
    uint objectCount;
    uint collidedCount;
    uint meshletCount;
    uint meshletIDCount;
    mat4 viewProj;
    vec4 planes[6];
    vec2 resolution;
    vec3 cameraPosition;
};

layout(push_constant) uniform PushConstants
{
    MeshRef meshPtr;
    MeshletRef meshletPtr;
    MeshletIDRef meshletIDPtr;
    MiscRef miscPtr;
};

taskPayloadSharedEXT MeshPayload taskData;
shared uint visibleCount;

bool isMeshletVisible(uint globalID)
{
    MeshletID2 mid = meshletIDPtr.ids[globalID];
    Mesh mesh = meshPtr.meshes[mid.meshID];
    Meshlet2 meshlet = meshletPtr.meshlets[mid.meshletID];
    vec3 center = (mesh.transform * vec4(meshlet.bounding.center, 1.0)).xyz;
    float scale = max(length(mesh.transform[0].xyz), max(length(mesh.transform[1].xyz), length(mesh.transform[2].xyz)));
    float radius = meshlet.bounding.radius * scale;

    vec3 normal = mat3(mesh.transform) * meshlet.bounding.normal;
    float len = length(normal);
    if (len != 0.)
        normal /= len;
    vec3 coneApex = (mesh.transform * vec4(meshlet.bounding.coneApex, 1.0)).xyz;

    if (((CullMode & CULL_FRUSTUM) != 0 && !isSphereInsideFrustum(center, radius, miscPtr.planes)) ||
            ((CullMode & CULL_BACKFACE) != 0 && !isMeshletFacingCamera(miscPtr.cameraPosition, coneApex, normal, meshlet.bounding.cutoff)))
        return false;

    return true;
}

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0)
        visibleCount = 0;

    barrier();

    if (globalID < miscPtr.meshletIDCount)
    {
        bool visible = isMeshletVisible(globalID); //meshletIDs[globalID << 1], meshletIDs[(globalID << 1) ^ 1]);

        if (visible)
        {
            uint index = atomicAdd(visibleCount, 1);
            taskData.visibleIndices[index] = globalID;
        }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0)
        EmitMeshTasksEXT(visibleCount, 1, 1);
    else
        EmitMeshTasksEXT(0, 0, 0);
}
