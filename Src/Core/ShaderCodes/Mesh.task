#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_buffer_reference: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 0) const int CullMode = 0;

layout(scalar, buffer_reference) buffer VertexRef
{
    Vertex vertices[];
};

layout(scalar, buffer_reference) buffer ObjectRef
{
    Object objects[];
};

layout(std430, buffer_reference) buffer MiscRef
{
    uint objectCount;
    uint collidedCount;
    uint meshletCount;
    uint meshletIDCount;
    vec4 planes[6];
    vec2 resolution;
};

layout(scalar, buffer_reference) buffer CollisionRef
{
    CollisionData collisions[];
};

layout(std430, buffer_reference) buffer MeshletIDRef
{
    MeshletID meshletIDs[];
};

layout(std430, buffer_reference) buffer MeshletRef
{
    Meshlet meshlets[];
};

layout(std430, buffer_reference, buffer_reference_align = 4) buffer MeshletVertexRef
{
    uint vertices[];
};

layout(buffer_reference) buffer MeshletIndexRef
{
    uint8_t indices[];
};

layout(std430, buffer_reference) buffer MeshletCullingRef
{
    BoundingSphere boundings[];
};

layout(push_constant) uniform PushConstants
{
    mat4 viewProj;
    VertexRef vertexPtr;
    ObjectRef objectPtr;
    MiscRef miscPtr;
    MeshletRef meshletPtr;
    MeshletVertexRef meshVertexPtr;
    MeshletIndexRef meshIndexPtr;
    MeshletCullingRef meshletCullingPtr;
};

taskPayloadSharedEXT MeshPayload taskData;
shared uint visibleCount;

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    visibleCount = 0;
    barrier();

    if (globalID < miscPtr.meshletIDCount)
    {
        bool visible = true;//CullMode == 0 || isMeshletVisible(meshletIDs[globalID].meshletID, meshletIDs[globalID].objectID); //meshletIDs[globalID << 1], meshletIDs[(globalID << 1) ^ 1]);

        if (visible)
        {
            uint index = atomicAdd(visibleCount, 1);
            taskData.visibleIndices[index] = globalID;
        }

        taskData.visibleCount = visibleCount;
    }
    barrier();
    EmitMeshTasksEXT(visibleCount, 1, 1);
}
