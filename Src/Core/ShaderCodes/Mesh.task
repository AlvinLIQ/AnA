#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_scalar_block_layout: enable
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(std430, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 1, binding = 1) uniform Frustum
{
    vec4 planes[6];
} frustum;

layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    uint meshlets[];
} msbo;

struct BoundingSphere
{
    vec3 center;
    uint farVertexID;
    vec3 normal;
    float cutoff;
    vec3 coneApex;
    float shit;
};

layout(std430, set = 6, binding = 1) buffer meshletCullingSSBO
{
    BoundingSphere boundings[];
} mcsbo;

struct MeshletID
{
    uint meshletID;
    uint objectID;
};

layout(std430, set = 6, binding = 2) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = 6, binding = 3) buffer MeshletIDCountSSBO
{
	uint meshletIDCount;
};

taskPayloadSharedEXT struct {
    uint visibleIndices[512]; // max 512 visible meshlets per group
    uint visibleCount;
} taskData;

bool isSphereInsideFrustum(in vec3 center, in float radius)
{
    for (int i = 0; i < 6; ++i)
    {
        vec4 plane = frustum.planes[i];
        float d = dot(plane.xyz, center) + plane.w + radius;
        if (d < 0)
            return false;
    }
    return true;
}

bool isMeshletFacingCamera(in vec3 coneApex, in vec3 coneAxis, in float cutoff)
{
    return dot(normalize(coneApex - cbo.position.xyz), coneAxis) <= cutoff;
}

bool isMeshletVisible(uint meshletId)
{
    MeshletID mid = meshletIDs[meshletId];
    BoundingSphere boundingSphere = mcsbo.boundings[mid.meshletID];
    mat4 transform = objects[mid.objectID].transform;
    transform[3].w = 1.0;
    vec3 center = (transform * vec4(boundingSphere.center, 1.0)).xyz;
    float radius = distance(center, 
        vec3(transform * vec4(vertices[msbo.meshlets[msbo.meshlets[mid.meshletID] + 3 + boundingSphere.farVertexID]].position, 1.0)));
    vec3 normal = mat3(transform) * boundingSphere.normal;
    float len = length(normal);
    if (len != 0.)
        normal /= len;
    vec3 coneApex = (transform * vec4(boundingSphere.coneApex, 1.0)).xyz;
    return  isSphereInsideFrustum(center, radius) && 
            isMeshletFacingCamera(coneApex, normal, boundingSphere.cutoff);
}

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    if (globalID >= meshletIDCount)
        return;
    bool visible = isMeshletVisible(globalID);
    
    uvec4 ballot = subgroupBallot(visible);
    if (visible)
    {
        uint index = subgroupBallotExclusiveBitCount(ballot);
        taskData.visibleIndices[index] = globalID;
    }

    if (gl_LocalInvocationIndex == 0)
    {
        uint total = subgroupBallotBitCount(ballot);
        taskData.visibleCount = total;
	    EmitMeshTasksEXT(total, 1, 1);
    }
}