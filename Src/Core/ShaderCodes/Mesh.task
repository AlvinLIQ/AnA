#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(scalar, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 1, binding = 1) uniform Frustum
{
    vec4 planes[6];
} frustum;

layout(scalar, set = 6, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(scalar, set = 6, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(scalar, set = 6, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

layout(scalar, set = 6, binding = 3) buffer meshletCullingSSBO
{
    BoundingSphere boundings[];
} mcsbo;

layout(scalar, set = 6, binding = 4) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = 6, binding = 5) buffer MeshletIDCountSSBO
{
	uint meshletIDCount;
};

taskPayloadSharedEXT MeshPayload taskData;
shared uint visibleCount;

bool isMeshletVisible(MeshletID mid)
{
    Meshlet meshlet = meshlets[mid.meshletID];
    BoundingSphere boundingSphere = mcsbo.boundings[mid.meshletID];
    mat4 transform = objects[mid.objectID].transform;
    transform[3].w = 1.0;
    vec3 center = (transform * vec4(boundingSphere.center, 1.0)).xyz;
    float radius = distance(center,
        vec3(transform * vec4(vertices[mvsbo.vertices[meshlets[mid.meshletID].vertexOffset + mcsbo.boundings[mid.meshletID].farVertexID]].position, 1.0)));
    vec3 normal = mat3(transform) * boundingSphere.normal;
    float len = length(normal);
    if (len != 0.)
        normal /= len;
    vec3 coneApex = (transform * vec4(boundingSphere.coneApex, 1.0)).xyz;
    return  isSphereInsideFrustum(center, radius, frustum.planes) &&
            isMeshletFacingCamera(cbo.position.xyz, coneApex, normal, boundingSphere.cutoff);
}

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    if (globalID >= meshletIDCount)
        return;

    visibleCount = 0;
    barrier();
    bool visible = isMeshletVisible(meshletIDs[globalID]);

    if (visible)
    {
        uint index = atomicAdd(visibleCount, 1);
        taskData.visibleIndices[index] = globalID;
    }

    barrier();

	EmitMeshTasksEXT((visibleCount + 63) / 64, 1, 1);
}
