#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_buffer_reference: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"
#include "bindings.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = CULL_MODE_ID) const int CullMode = 0;

layout(scalar, buffer_reference) buffer VertexRef
{
    Vertex vertices[];
};

layout(scalar, buffer_reference) buffer ObjectRef
{
    Object objects[];
};

layout(scalar, buffer_reference) buffer MiscRef
{
    uint objectCount;
    uint collidedCount;
    uint meshletCount;
    uint meshletIDCount;
    vec4 planes[6];
    vec2 resolution;
    vec3 cameraPosition;
};

layout(scalar, buffer_reference) buffer CollisionRef
{
    CollisionData collisions[];
};

layout(scalar, buffer_reference) buffer MeshletIDRef
{
    MeshletID meshletIDs[];
};

layout(scalar, buffer_reference) buffer MeshletRef
{
    Meshlet meshlets[];
};

layout(scalar, buffer_reference) buffer MeshletVertexRef
{
    uint vertices[];
};

layout(scalar, buffer_reference) buffer MeshletIndexRef
{
    uint8_t indices[];
};

layout(scalar, buffer_reference) buffer MeshletCullingRef
{
    BoundingSphere boundings[];
};

layout(push_constant) uniform PushConstants
{
    mat4 viewProj;
    VertexRef vertexPtr;
    ObjectRef objectPtr;
    MiscRef miscPtr;
    MeshletIDRef meshletIDPtr;
    MeshletRef meshletPtr;
    MeshletVertexRef meshVertexPtr;
    MeshletIndexRef meshIndexPtr;
    MeshletCullingRef meshletCullingPtr;
};

taskPayloadSharedEXT MeshPayload taskData;
shared uint visibleCount;

bool isMeshletVisible(uint meshletID, uint objectID)
{
    if (meshletID > miscPtr.meshletCount || objectID > miscPtr.objectCount)
        return false;
    Meshlet meshlet = meshletPtr.meshlets[meshletID];
    BoundingSphere boundingSphere = meshletCullingPtr.boundings[meshletID];
    mat4 transform = objectPtr.objects[objectID].transform;
    vec3 center = (transform * vec4(boundingSphere.center, 1.0)).xyz;
    float scale = max(length(transform[0].xyz), max(length(transform[1].xyz), length(transform[2].xyz)));
    float radius = boundingSphere.radius * scale;

    vec3 normal = mat3(transform) * boundingSphere.normal;
    float len = length(normal);
    if (len != 0.)
        normal /= len;
    vec3 coneApex = (transform * vec4(boundingSphere.coneApex, 1.0)).xyz;

    if (((CullMode & CULL_FRUSTUM) != 0 && !isSphereInsideFrustum(center, radius, miscPtr.planes)) ||
            ((CullMode & CULL_BACKFACE) != 0 && !isMeshletFacingCamera(miscPtr.cameraPosition, coneApex, normal, boundingSphere.cutoff)))
        return false;

    return true;
}

void main()
{
    uint globalID = gl_GlobalInvocationID.x;
    visibleCount = 0;
    barrier();

    if (globalID < miscPtr.meshletIDCount)
    {
        bool visible = isMeshletVisible(meshletIDPtr.meshletIDs[globalID].meshletID,
                meshletIDPtr.meshletIDs[globalID].objectID); //meshletIDs[globalID << 1], meshletIDs[(globalID << 1) ^ 1]);

        if (visible)
        {
            uint index = atomicAdd(visibleCount, 1);
            taskData.visibleIndices[index] = globalID;
        }

        taskData.visibleCount = visibleCount;
    }
    barrier();
    EmitMeshTasksEXT(visibleCount, 1, 1);
}
