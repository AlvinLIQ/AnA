#version 460
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_VERTICES, max_primitives = MAX_PRIMITIVES) out;

#ifdef PER_PRIMITIVE_NORMAL
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 vertexPosition;
    float viewPosZ;
};
layout(location = 4) perprimitiveEXT out vec3 primitiveNormals[];
#else
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
    float viewPosZ;
};
#endif

layout(location = 0) out VertexOutput vertexOutput[];

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(scalar, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 2
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

layout(scalar, set = 6, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(scalar, set = 6, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(scalar, set = 6, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

layout(scalar, set = 6, binding = 4) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

taskPayloadSharedEXT MeshPayload taskData;

shared vec3 worldVertices[MAX_VERTICES];

void main()
{
    MeshletID mid = meshletIDs[taskData.visibleIndices[gl_WorkGroupID.x]];
	Meshlet meshlet = meshlets[mid.meshletID];
    uint primitiveCount = meshlet.indexCount / 3;
    SetMeshOutputsEXT(meshlet.vertexCount, primitiveCount);

	mat4 viewProj = cbo.proj * cbo.view;
    float zOffset = ubo.cascades[1].split - ubo.cascades[0].split * 1.75;
    mat4 transform = objects[mid.objectID].transform;
    uint texID = uint(transform[3].w);
    transform[3].w = 1.0;
    
    for (uint i = 0; i < meshlet.vertexCount; i++)
    {
        Vertex vertex = vertices[mvsbo.vertices[meshlet.vertexOffset + i]];
        vec4 vertexPos = transform * vec4(vertex.position, 1.0);
        worldVertices[i] = vertexPos.xyz;
        vec4 viewPos = cbo.view * vertexPos;
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vertexPos;
        vertexOutput[i].texCoord = vertex.uv;
        vertexOutput[i].texID = texID;
#ifndef PER_PRIMITIVE_NORMAL
        vertexOutput[i].normalSpace = vertex.normal;
#endif
        vertexOutput[i].vertexPosition = vertexPos.xyz;
        vertexOutput[i].viewPosZ = viewPos.z / viewPos.w + zOffset;
    }

    for (uint i = 0, offset = meshlet.indexOffset; i < primitiveCount; offset += 3)
    {
	    gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            primitives[offset + 0], 
            primitives[offset + 1],
            primitives[offset + 2]
        );
        vec3 a = worldVertices[uint(primitives[offset + 0])];
        vec3 b = worldVertices[uint(primitives[offset + 1])];
        vec3 c = worldVertices[uint(primitives[offset + 2])];
        vec3 normal = normalize(cross(b - a, c - a));
        vec3 coneApex = (a + b + c) / 3.0;

        gl_MeshPrimitivesEXT[i].gl_CullPrimitiveEXT = dot(normal, normalize(cbo.position.xyz - coneApex)) <= 0.0;
#ifdef PER_PRIMITIVE_NORMAL
        primitiveNormals[i] = normal;
#endif
        ++i;
    }
}