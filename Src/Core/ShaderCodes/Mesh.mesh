#version 460
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"
#include "bindings.h"

layout(local_size_x = MAX_PRIMITIVES, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_VERTICES, max_primitives = MAX_PRIMITIVES) out;

#ifdef PER_PRIMITIVE_NORMAL
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 vertexPosition;
    vec3 color;
};
layout(location = 4) perprimitiveEXT out vec3 primitiveNormals[];
#else
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
    vec3 color;
};
#endif

layout(location = 0) out VertexOutput vertexOutput[];

layout(scalar, set = DEFAULT_VERTEX_LAYOUT, binding = BIND_VERTEX) buffer VertexSSBO
{
    Vertex vertices[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT) buffer ObjectSSBO
{
    Object objects[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_MESHLET_ID) buffer meshletIDSSBO
{
    uint meshletIDs[];
};

layout(std430, set = DEFAULT_OBJECT_LAYOUT, binding = BIND_OBJECT_MESHLET_ID_COUNT) buffer MeshletIDCountSSBO
{
    uint meshletIDCount;
};

layout(set = DEFAULT_UBO_LAYOUT, binding = BIND_CAMERA) buffer CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 2
struct Cascade {
    mat4 viewProj;
    float split;
};
layout(set = 5, binding = 0) uniform UBO {
    Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

layout(set = DEFAULT_MESHLET_LAYOUT, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(std430, set = DEFAULT_MESHLET_LAYOUT, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(set = DEFAULT_MESHLET_LAYOUT, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

taskPayloadSharedEXT MeshPayload taskData;

shared vec3 worldVertices[MAX_VERTICES];

void main()
{
    uint midOffset = taskData.visibleIndices[gl_WorkGroupID.x] << 1;
    uint meshletID = meshletIDs[midOffset];
    uint objectID = meshletIDs[midOffset ^ 1];
    Meshlet meshlet = meshlets[meshletID];
    uint primitiveCount = meshlet.indexCount / 3;
    SetMeshOutputsEXT(meshlet.vertexCount, primitiveCount);

    mat4 viewProj = cbo.proj * cbo.view;
    mat4 transform = objects[objectID].transform;
    uint texID = uint(transform[3].w);
    transform[3].w = 1.0;

    uint i = gl_LocalInvocationID.x;
    if (i < meshlet.vertexCount)
    {
        Vertex vertex = vertices[mvsbo.vertices[meshlet.vertexOffset + i]];
        vec4 vertexPos = transform * vec4(vertex.position, 1.0);
        worldVertices[i] = vertexPos.xyz;
        vec4 viewPos = cbo.view * vertexPos;
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vertexPos;
        gl_MeshVerticesEXT[i].gl_PointSize = 6.0;
        vertexOutput[i].texCoord = vertex.uv;
        vertexOutput[i].texID = texID;
        vertexOutput[i].color = vec3(
            float(vertex.color.r) / 255.0,
            float(vertex.color.g) / 255.0,
            float(vertex.color.b) / 255.0
        );
        #ifndef PER_PRIMITIVE_NORMAL
        vertexOutput[i].normalSpace = normalize(transpose(inverse(mat3(transform))) * CalculateNormal(vertex.pitch, vertex.yaw));
        #endif
        vertexOutput[i].vertexPosition = vertexPos.xyz;
    }

    barrier();

    if (i < primitiveCount)
    {
        uint indexOffset = meshlet.indexOffset + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
                primitives[indexOffset + 0],
                primitives[indexOffset + 1],
                primitives[indexOffset + 2]
            );
        vec3 a = worldVertices[uint(primitives[indexOffset + 0])];
        vec3 b = worldVertices[uint(primitives[indexOffset + 1])];
        vec3 c = worldVertices[uint(primitives[indexOffset + 2])];
        vec3 normal = normalize(cross(b - a, c - a));
        vec3 coneApex = (a + b + c) / 3.0;

        gl_MeshPrimitivesEXT[i].gl_CullPrimitiveEXT = dot(normal, normalize(cbo.position.xyz - coneApex)) <= 0.0;
        #ifdef PER_PRIMITIVE_NORMAL
        primitiveNormals[i] = normal;
        #endif
    }
}
