#version 460
#extension GL_EXT_mesh_shader: require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 128, max_primitives = 256) out;

struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
    vec4 viewPos;
};

layout(location = 0) out VertexOutput vertexOutput[];

struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std140, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 3
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    uint meshlets[];
} msbo;

const uint bytesToBits[4] = {0u, 8u, 16u, 24u};
const uint bytesMask[4] = {0xFFFFFFu, 0xFFFFFFu, 0xFFFF00u, 0xFF0000u};
const uint rQBytesToBits[4] = {0u, 8u, 8u, 8u};
const uint rQBytesMask[4] = {0x0u, 0x0u, 0xFFu, 0xFFFFu};

taskPayloadSharedEXT struct {
    uint visibleIndices[512]; // max 512 visible meshlets per group
    uint visibleCount;
} taskData;

void main()
{
	uint iid = msbo.meshlets[taskData.visibleIndices[gl_WorkGroupID.x]];
    uint vertexCount = msbo.meshlets[iid++];
    uint primitiveCount = msbo.meshlets[iid++];
    SetMeshOutputsEXT(vertexCount, primitiveCount);
//gl_LocalInvocationIndex
	mat4 viewProj = cbo.proj * cbo.view;
    for (uint i = 0; i < vertexCount; i++)
    {
        Vertex vertex = vsbo.vertices[msbo.meshlets[iid + i]];
        vec4 vertexPos = vec4(vertex.position, 1.0);
        vec4 viewPos = cbo.view * vertexPos;
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vertexPos;
        vertexOutput[i].texCoord = vertex.uv;
        vertexOutput[i].texID = vertex.texIndex;
        vertexOutput[i].normalSpace = vertex.normal;
        vertexOutput[i].vertexPosition = vertex.position;
        vertexOutput[i].viewPos = viewPos;
    }
    iid += vertexCount;
    for (uint i = 0, j, offset, t; i < primitiveCount; i++)
    {
        t = (i << 1) + i;
        j = t >> 2;
        offset = (t & 3);
        uint packed =   ((msbo.meshlets[iid + j] >> rQBytesToBits[offset]) & bytesMask[offset]) | 
                        (msbo.meshlets[iid + j + 1] & rQBytesMask[offset]);

	    gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            (packed >> 0u) & 0xFFu, 
            (packed >> 8u) & 0xFFu,
            (packed >> 16u) & 0xFFu);
    }
}