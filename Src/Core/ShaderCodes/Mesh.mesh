#version 460
#extension GL_EXT_mesh_shader: require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 128, max_primitives = 256) out;

struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
    vec4 viewPos;
};

layout(location = 0) out VertexOutput vertexOutput[];

struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std140, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 4
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

struct Meshlet
{
   uint vertices[128];
   uint indices[256*3];
   uint indexCount;
   uint vertexCount; 
};

layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    uint meshlets[];
} msbo;

const vec4[3] positions = {
	vec4( 0.0, -1.0, 0.0, 1.0),
	vec4(-1.0,  1.0, 0.0, 1.0),
	vec4( 1.0,  1.0, 0.0, 1.0)
};

const vec4[3] colors = {
	vec4(0.0, 1.0, 0.0, 1.0),
	vec4(0.0, 0.0, 1.0, 1.0),
	vec4(1.0, 0.0, 0.0, 1.0)
};

taskPayloadSharedEXT uint visibleMeshletIndices[32];

void main()
{
	uint iid = msbo.meshlets[gl_WorkGroupID.x] + 1;
    uint vertexCount = msbo.meshlets[iid++];
    uint primitiveCount = msbo.meshlets[iid++];
//gl_LocalInvocationIndex
	mat4 viewProj = cbo.proj * cbo.view;
	SetMeshOutputsEXT(vertexCount, primitiveCount);
    for (uint i = 0; i < vertexCount; i++)
    {
        Vertex vertex = vsbo.vertices[msbo.meshlets[iid + i]];
        vec4 vertexPos = vec4(vertex.position, 1.0);
        vec4 viewPos = cbo.view * vertexPos;
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vec4(vertex.position, 1.0);
        vertexOutput[i].texCoord = vertex.uv;
        vertexOutput[i].texID = vertex.texIndex;
        vertexOutput[i].normalSpace = vertex.normal;
        vertexOutput[i].vertexPosition = vertex.position;
        vertexOutput[i].viewPos = viewPos;
    }
    iid += vertexCount;
    for (uint i = 0; i < primitiveCount; i++)
    {
        uint packed = msbo.meshlets[iid + i];
	    gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            (packed >> 0u) & 0xFFu, 
            (packed >> 8u) & 0xFFu,
            (packed >> 16u) & 0xFFu);
    }
}