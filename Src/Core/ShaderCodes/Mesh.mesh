#version 460
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_nonuniform_qualifier : enable 

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;

struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std140, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 4
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

struct Meshlet
{
   uint vertices[64];
   uint indices[126*3];
   uint indexCount;
   uint vertexCount; 
};

layout(std140, set = 6, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
} msbo;

void main()
{
	uint iid = gl_LocalInvocationID.x;

    SetMeshOutputsEXT(uint(msbo.meshlets[iid].indexCount), 1);
	for (uint i = 0; i < uint(msbo.meshlets[iid].vertexCount); ++i)
	{
		uint vertexIndex = msbo.meshlets[iid].vertices[i];
		Vertex vertex = vsbo.vertices[vertexIndex];
        vec4 vertexPos = vec4(vertex.position, 1.0);
        vec4 viewPos = cbo.view * vertexPos;

		gl_MeshVerticesEXT[i].gl_Position = cbo.proj * viewPos;
	}

	for (uint i = 0; i < uint(msbo.meshlets[iid].indexCount); i += 3)
	{
		gl_PrimitiveTriangleIndicesEXT[i] = uvec3(msbo.meshlets[iid].indices[i], msbo.meshlets[iid].indices[i + 1], msbo.meshlets[iid].indices[i + 2]);
	}
}