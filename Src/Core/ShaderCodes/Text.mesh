#version 460
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 128, max_primitives = 256) out;

layout(location = 0) out vec3 outColors[];
layout(location = 1) flat out vec4 scissors[];

layout(scalar, set = 0, binding = 0) buffer VertexBufferObject {
    vec2 vertices[];
};

struct CharacterInfo
{
    uint ch;
    uint index;
};

layout(scalar, set = 1, binding = 0) buffer CharacterInfoBufferObject {
    CharacterInfo charInfos[];
};

struct TextData
{
    float size;
    vec2 offset;
    vec3 color;
    vec4 scissor;
    uint chOffset;
    uint count;
};

layout(scalar, set = 1, binding = 1) buffer TextDataBufferObject {
    TextData textInfos[];
};

layout(scalar, set = 2, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(scalar, set = 2, binding = 1) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

taskPayloadSharedEXT struct {
    uint textIndex;
} taskData;

const vec2 charSize = vec2(0.836363613, 0.99999994);

layout(push_constant) uniform PushConsts {
    vec2 resolution;
} push;

void main()
{
    TextData textInfo = textInfos[taskData.textIndex];
    CharacterInfo chInfo = charInfos[gl_WorkGroupID.x + textInfo.chOffset];
    Meshlet meshlet = meshlets[uint(chInfo.ch)];
    uint primitiveCount = meshlet.indexCount / 3;
    SetMeshOutputsEXT(meshlet.vertexCount, primitiveCount);
    vec2 scale = vec2(textInfo.size / push.resolution.x, textInfo.size / push.resolution.y);
    for (uint i = 0; i < meshlet.vertexCount; i++)
    {
        vec2 pos = scale * charSize * vertices[meshlet.vertexOffset + i];
        pos.x += scale.x * charSize.x * float(chInfo.index) - 1.;
        pos.y = -pos.y - charSize.y + scale.y;
        gl_MeshVerticesEXT[i].gl_Position = vec4(pos + textInfo.offset, 0.0, 1.0);
        outColors[i] = textInfo.color;
        scissors[i] = textInfo.scissor;
    }

    for (uint i = 0, offset; i < primitiveCount; i++)
    {
        offset = meshlet.indexOffset + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
                primitives[offset + 0],
                primitives[offset + 1],
                primitives[offset + 2]
            );
    }
}
