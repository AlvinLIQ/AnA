#version 460
#extension GL_EXT_mesh_shader: require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;

layout(location = 0) out VertexOutput
{
	vec4 color;
} vertexOutput[];

struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std140, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 4
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

struct Meshlet
{
   uint vertices[64];
   uint indices[126*3];
   uint indexCount;
   uint vertexCount; 
};

layout(std140, set = 6, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
} msbo;

const vec4[3] positions = {
	vec4( 0.0, -1.0, 0.0, 1.0),
	vec4(-1.0,  1.0, 0.0, 1.0),
	vec4( 1.0,  1.0, 0.0, 1.0)
};

const vec4[3] colors = {
	vec4(0.0, 1.0, 0.0, 1.0),
	vec4(0.0, 0.0, 1.0, 1.0),
	vec4(1.0, 0.0, 0.0, 1.0)
};

void main()
{
	uint iid = gl_LocalInvocationID.x;
    uint vertexCount = msbo.meshlets[iid].vertexCount;
    uint indexCount = msbo.meshlets[iid].indexCount;
//gl_LocalInvocationIndex
	mat4 viewProj = cbo.proj * cbo.view;
	SetMeshOutputsEXT(vertexCount, indexCount / 3);
    for (uint i = 0; i < vertexCount; i++)
    {
        Vertex vertex = vsbo.vertices[msbo.meshlets[iid].vertices[i]];
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vec4(vertex.position, 1.0);
        vertexOutput[i].color = colors[iid % 3];
    }
    for (uint i = 0, j; i < indexCount; i += 3, j += 1)
    {
	    gl_PrimitiveTriangleIndicesEXT[j] = uvec3(
            msbo.meshlets[iid].indices[i], 
            msbo.meshlets[iid].indices[i + 1],
            msbo.meshlets[iid].indices[i + 2]);
    }
}