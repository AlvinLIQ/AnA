#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_scalar_block_layout: enable
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(std430, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 1, binding = 1) uniform Frustum
{
    vec4 planes[6];
} frustum;

#define SHADOW_MAP_CASCADE_COUNT 3
struct Cascade {
    mat4 viewProj;
    float split;
};

layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
};

layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    uint meshlets[];
} msbo;

struct MeshletID
{
    uint meshletID;
    uint objectID;
};

layout(std430, set = 6, binding = 2) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = 6, binding = 3) buffer MeshletIDCountSSBO
{
	uint meshletIDCount;
};

taskPayloadSharedEXT struct {
    uint visibleIndices[512]; // max 512 visible meshlets per group
    uint visibleCount;
} taskData;

void main()
{
    MeshletID mid = meshletIDs[taskData.visibleIndices[gl_WorkGroupID.x]];
	uint iid = msbo.meshlets[mid.meshletID];
    uint vertexCount = msbo.meshlets[iid++];
    uint primitiveCount = msbo.meshlets[iid++];
    SetMeshOutputsEXT(vertexCount, primitiveCount);
//gl_LocalInvocationIndex
	mat4 viewProj = cascades[gl_WorkGroupID.y].viewProj;
    mat4 transform = objects[mid.objectID].transform;
    transform[3].w = 1.0;
    
    for (uint i = 0, vertexOffset; i < vertexCount; i++)
    {
        Vertex vertex = vertices[msbo.meshlets[iid + i]];
        vec4 vertexPos = transform * vec4(vertex.position, 1.0);
        gl_MeshVerticesEXT[i].gl_Position = viewProj * vertexPos;
    }
    iid += vertexCount;
    for (uint i = 0, j, offset, t; i < primitiveCount; i++)
    {
        t = (i << 1) + i;
        j = t >> 2;
        offset = (t & 3);
        uint packed =   ((msbo.meshlets[iid + j] >> rQBytesToBits[offset]) & bytesMask[offset]) | 
                        (msbo.meshlets[iid + j + 1] & rQBytesMask[offset]);

	    gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            (packed >> 0u) & 0xFFu, 
            (packed >> 8u) & 0xFFu,
            (packed >> 16u) & 0xFFu);

        gl_MeshPrimitivesEXT[i].gl_Layer = int(gl_WorkGroupID.y);
    }
}