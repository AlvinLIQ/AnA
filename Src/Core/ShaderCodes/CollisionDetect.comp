#version 460
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
struct Projection
{
    vec2 pos1;
    vec2 pos2;
};

layout(std430, set = 0, binding = 1) buffer ObjectBuffer
{
    Object objects[];
};

layout(std430, set = 0, binding = 2) buffer countBuffer
{
    uint objectCount;
};
/*
layout(std430, set = 1, binding = 0) buffer SSBOOut
{
    uvec2 collidedPairs[];
};
*/
shared uint collidedCount;

bool AABBTest(vec3 AB, vec3 halfA, vec3 halfB)
{
    for (int i = 0; i < 3; i++)
    {
        if (abs(AB[i]) > halfA[i] + halfB[i])
            return false;
    }
    return true;
}

void main()
{
    uint pos = gl_GlobalInvocationID.x;
    collidedCount = 0;
    barrier();
    if (pos > objectCount)
        return;

    for (uint i = 0; i < pos; i++)
    { 
        float r = objects[i].radius + objects[pos].radius;
        vec3 relativePos = objects[i].center - objects[pos].center;
        if (dot(relativePos, relativePos) <= r * r && AABBTest(relativePos, objects[i].halfVolume.xyz, objects[pos].halfVolume.xyz))
        {
            uint index = atomicAdd(collidedCount, 1);
            //collidedPairs[index] = uvec2(i, pos);
            objects[i].transform[3].w = 2.0;
            objects[pos].transform[3].w = 2.0;
        }
    }
}