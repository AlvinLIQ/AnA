#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_GOOGLE_include_directive : require

#include "math.h"
#include "mesh.h"
#include "bindings.h"

#define MAX_ROW_VERTICES 8
#define MAX_COLUMN_VERTICES 8
#define MAX_TERRAIN_PRIMITIVES (MAX_COLUMN_VERTICES - 1) * (MAX_ROW_VERTICES - 1) * 2

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_ROW_VERTICES * MAX_ROW_VERTICES, max_primitives = MAX_TERRAIN_PRIMITIVES) out;

shared vec3 worldVertices[MAX_COLUMN_VERTICES * MAX_ROW_VERTICES];

#ifdef PER_PRIMITIVE_NORMAL
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 vertexPosition;
};
layout(location = 4) perprimitiveEXT out vec3 primitiveNormals[];
#else
struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
};
#endif

layout(location = 0) out VertexOutput vertexOutput[];

layout(set = DEFAULT_UBO_LAYOUT, binding = 0) buffer CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

layout(push_constant) uniform PushConsts {
    float density;
    float height;
    uint texID;
    uint calNormal;
} push;

taskPayloadSharedEXT struct {
    float scale;
    vec3 center;
} taskData;

void main()
{
    const uint vertexCount = MAX_ROW_VERTICES * MAX_COLUMN_VERTICES;
    const uint primitiveCount = MAX_TERRAIN_PRIMITIVES;
    SetMeshOutputsEXT(vertexCount, primitiveCount);
    uint id = 0;
    mat4 viewProj = cbo.proj * cbo.view;
    float scale = taskData.scale;
    uint column = gl_WorkGroupID.x * (MAX_COLUMN_VERTICES - 1);
    uint row = gl_WorkGroupID.y * (MAX_ROW_VERTICES - 1);
    vec2 offset = vec2(float(column) * scale, float(row) * scale);
    vec2 pos;
    vec3 vertex;
    vec4 viewPos;
    for (float y = 0., x, ax, ay; y < float(MAX_ROW_VERTICES); y++)
    {
        for (x = 0.; x < float(MAX_COLUMN_VERTICES); x++)
        {
            pos = vec2(x * scale, y * scale) + offset;
            vertex = vec3(pos.x, -Terrain((pos) * push.height) - 20.0f, pos.y) - taskData.center;

            gl_MeshVerticesEXT[id].gl_PointSize = 4;
            vec4 vertexPos = viewProj * vec4(vertex, 1.0);
            worldVertices[id] = vertexPos.xyz;
            gl_MeshVerticesEXT[id].gl_Position = vertexPos;
            vertexOutput[id].texCoord = vec2(x * 0.1, y * 0.1);
            vertexOutput[id].texID = push.texID;
            #ifndef PER_PRIMITIVE_NORMAL
            vertexOutput[id].normalSpace = push.calNormal == 1 ? CalculateNormal(pos * -push.height) : vec3(0.);
            #endif
            vertexOutput[id].vertexPosition = vertex;
            viewPos = cbo.view * vec4(vertex, 1.0);
            ++id;
        }
    }

    id = 0;
    uint a, b, c, d;

    for (uint y = 0, x; y < MAX_ROW_VERTICES - 1; y++)
    {
        for (x = 0; x < MAX_COLUMN_VERTICES - 1; x++)
        {
            a = x + y * MAX_COLUMN_VERTICES;
            b = a + 1;
            c = a + MAX_COLUMN_VERTICES;
            d = b + MAX_COLUMN_VERTICES;
            #ifdef PER_PRIMITIVE_NORMAL
            vec3 pa = worldVertices[a];
            vec3 pb = worldVertices[b];
            vec3 pc = worldVertices[c];
            vec3 normal = normalize(cross(pb - pa, pc - pa));
            primitiveNormals[id] = push.calNormal == 1 ? normal : vec3(0.);
            #endif
            gl_PrimitiveTriangleIndicesEXT[id++] = uvec3(a, b, c);
            #ifdef PER_PRIMITIVE_NORMAL
            vec3 pd = worldVertices[d];
            normal = normalize(cross(pb - pc, pd - pc));
            primitiveNormals[id] = push.calNormal == 1 ? normal : vec3(0.);
            #endif
            gl_PrimitiveTriangleIndicesEXT[id++] = uvec3(c, b, d);
        }
    }
}
