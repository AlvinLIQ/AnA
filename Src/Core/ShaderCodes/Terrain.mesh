#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_GOOGLE_include_directive : require

#include "math.h"

#define MAX_ROW_VERTICES 8
#define MAX_COLUMN_VERTICES 8
#define MAX_PRIMITIVES (MAX_COLUMN_VERTICES - 1) * (MAX_ROW_VERTICES - 1) * 2

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MAX_ROW_VERTICES * MAX_ROW_VERTICES, max_primitives = MAX_PRIMITIVES) out;


struct VertexOutput {
    vec2 texCoord;
    uint texID;
    vec3 normalSpace;
    vec3 vertexPosition;
    float viewPosZ;
};

layout(location = 0) out VertexOutput vertexOutput[];

struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std430, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 3
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

layout(push_constant) uniform PushConsts {
	float density;
    float height;
    uint texID;
} push;

taskPayloadSharedEXT struct {
    float scale;
    vec3 center;
} taskData;

void main()
{
    const uint vertexCount = MAX_ROW_VERTICES * MAX_COLUMN_VERTICES;
    const uint primitiveCount = MAX_PRIMITIVES;
    SetMeshOutputsEXT(vertexCount, primitiveCount);
    uint id = 0;
    mat4 viewProj = cbo.proj * cbo.view;
    float scale = taskData.scale;
    uint column = gl_WorkGroupID.x * (MAX_COLUMN_VERTICES - 1);
    uint row = gl_WorkGroupID.y * (MAX_ROW_VERTICES - 1);
    vec2 offset = vec2(float(column) * scale, float(row) * scale);
    vec2 pos;
    vec3 vertex;
    vec4 viewPos;
    for (float y = 0., x, ax, ay; y < float(MAX_ROW_VERTICES); y++)
    {
        for (x = 0.; x < float(MAX_COLUMN_VERTICES); x++)
        {
            pos = vec2(x * scale, y * scale) + offset;
            vertex = vec3(pos.x, Terrain((pos) * push.height) + 10.0f, pos.y) - taskData.center;

            gl_MeshVerticesEXT[id].gl_Position = viewProj * vec4(vertex, 1.0);
            vertexOutput[id].texCoord = vec2(x * 0.1, y * 0.1);
            vertexOutput[id].texID = push.texID;
            vertexOutput[id].normalSpace = CalculateNormal(pos * push.height);
            vertexOutput[id].vertexPosition = vertex;
            viewPos = cbo.view * vec4(vertex, 1.0);
            vertexOutput[id].viewPosZ = viewPos.z / viewPos.w + ubo.cascades[1].split - ubo.cascades[0].split + 1.0;
            ++id;
        }
    }

    id = 0;
    uint a, b, c, d;
    for (uint y = 0, x; y < MAX_ROW_VERTICES - 1; y++)
    {
        for (x = 0; x < MAX_COLUMN_VERTICES - 1; x++)
        {
            a = x + y * MAX_COLUMN_VERTICES;
            b = a + 1;
            c = a + MAX_COLUMN_VERTICES;
            d = b + MAX_COLUMN_VERTICES;
            gl_PrimitiveTriangleIndicesEXT[id++] = uvec3(a, b, c);
            gl_PrimitiveTriangleIndicesEXT[id++] = uvec3(c, b, d);
        }
    }
}