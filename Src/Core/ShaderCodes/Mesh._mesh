#version 460
#extension GL_NV_mesh_shader: require
#extension GL_EXT_nonuniform_qualifier : enable 

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 126) out;


struct Vertex
{
    vec3 position;
    vec3 normal;
    vec2 uv;
    uint texIndex;
};

layout(std140, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
} vsbo;

struct Meshlet
{
   uint vertices[64];
   uint indices[126*3];
   uint indexCount;
   uint vertexCount; 
};

layout(std140, set = 0, binding = 1) buffer meshletSSBO
{
    Meshlet meshlets[];
} msbo;

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec2 resolution;
} cbo;

layout(set = 2, binding = 0) uniform LightBufferObject {
    mat4 proj;
    mat4 view;
    vec3 direction;
    vec3 color;
    float ambient;
} lbo;

#define SHADOW_MAP_CASCADE_COUNT 4
struct Cascade {
    mat4 viewProj;
    float split;
};
layout (set = 5, binding = 0) uniform UBO {
	Cascade[SHADOW_MAP_CASCADE_COUNT] cascades;
} ubo;

layout(set = 3, binding = 0) uniform sampler2D texSampler[];
layout(set = 4, binding = 0) uniform sampler2DArray shadowSampler;

void main()
{
	uint mi = gl_WorkGroupID.x;

	for (uint i = 0; i < uint(msbo.meshlets[mi].vertexCount); ++i)
	{
		uint vertexIndex = msbo.meshlets[mi].vertices[i];
		Vertex vertex = vsbo.vertices[vertexIndex];
        vec4 vertexPos = vec4(vertex.position, 1.0);
        vec4 viewPos = cbo.view * vertexPos;

		gl_MeshVerticesNV[i].gl_Position = cbo.proj * viewPos;

		fragColor[i] = vec3(texture(texSampler[nonuniformEXT(texIndex)], vertex.uv));
	}

    gl_PrimitiveCountNV = uint(msbo.meshlets[mi].indexCount) / 3;

	for (uint i = 0; i < uint(msbo.meshlets[mi].indexCount); ++i)
	{
		gl_PrimitiveIndicesNV[i] = uint(msbo.meshlets[mi].indices[i]);
	}
}