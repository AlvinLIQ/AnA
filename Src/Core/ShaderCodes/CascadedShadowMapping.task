#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: enable
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(std430, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 1, binding = 1) uniform Frustum
{
    vec4 planes[6];
} frustum;


layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(std430, set = 6, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(std430, set = 6, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

layout(std430, set = 6, binding = 3) buffer meshletCullingSSBO
{
    BoundingSphere boundings[];
} mcsbo;

layout(std430, set = 6, binding = 4) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = 6, binding = 5) buffer MeshletIDCountSSBO
{
	uint meshletIDCount;
};

void main()
{
    EmitMeshTasksEXT(meshletIDCount, 3, 1);
}
