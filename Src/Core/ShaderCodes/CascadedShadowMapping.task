#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_EXT_scalar_block_layout: enable
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0) buffer VertexSSBO
{
    Vertex vertices[];
};

struct Object
{
    mat4 transform;
};

layout(std430, set = 0, binding = 1) buffer ObjectSSBO
{
    Object objects[];
};

layout(set = 1, binding = 0) uniform CameraBufferObject {
    mat4 proj;
    mat4 view;
    vec4 position;
    vec2 resolution;
} cbo;

layout(set = 1, binding = 1) uniform Frustum
{
    vec4 planes[6];
} frustum;

layout(std430, set = 6, binding = 0) buffer meshletSSBO
{
    uint meshlets[];
} msbo;

struct BoundingSphere
{
    vec3 center;
    uint farVertexID;
    vec3 normal;
    float cutoff;
    vec3 coneApex;
    float shit;
};

layout(std430, set = 6, binding = 1) buffer meshletCullingSSBO
{
    BoundingSphere boundings[];
} mcsbo;

struct MeshletID
{
    uint meshletID;
    uint objectID;
};

layout(std430, set = 6, binding = 2) buffer meshletIDSSBO
{
    MeshletID meshletIDs[];
};

layout(std430, set = 6, binding = 3) buffer MeshletIDCountSSBO
{
	uint meshletIDCount;
};

bool isMeshletVisible(uint meshletId)
{
    MeshletID mid = meshletIDs[meshletId];
    BoundingSphere boundingSphere = mcsbo.boundings[mid.meshletID];
    mat4 transform = objects[mid.objectID].transform;
    transform[3].w = 1.0;
    vec3 center = (transform * vec4(boundingSphere.center, 1.0)).xyz;
    float radius = distance(center,
        vec3(transform * vec4(vertices[msbo.meshlets[msbo.meshlets[mid.meshletID] + 3 + boundingSphere.farVertexID]].position, 1.0)));
    return  isSphereInsideFrustum(center, radius, frustum.planes);
}

void main()
{
    EmitMeshTasksEXT(meshletIDCount, 3, 1);
}
