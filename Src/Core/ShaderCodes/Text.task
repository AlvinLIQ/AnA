#version 450
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_scalar_block_layout: enable
#extension GL_GOOGLE_include_directive : require

#include "mesh.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(scalar, set = 0, binding = 0) buffer VertexBufferObject {
    vec2 vertices[];
};

struct CharacterInfo{
    vec2 scale;
    vec2 offset;
    vec3 color;
    uint meshletID;
};

layout(scalar, set = 1, binding = 0) buffer CharacterInfoBufferObject {
    CharacterInfo charInfos[];
};

layout(scalar, set = 2, binding = 0) buffer meshletSSBO
{
    Meshlet meshlets[];
};

layout(std430, set = 2, binding = 1) buffer meshletVertexSSBO
{
    uint vertices[];
} mvsbo;

layout(scalar, set = 2, binding = 2) buffer meshletIndexSSBO
{
    uint8_t primitives[];
};

layout(scalar, set = 2, binding = 3) buffer meshletCountSSBO
{
    uint meshletCount;
};

void main()
{
    EmitMeshTasksEXT(meshletCount, 1, 1);
}