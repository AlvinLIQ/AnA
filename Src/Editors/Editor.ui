<StackPanel ControlSize="300.0f, 0.0f" Spacing="0.01f" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Orientation="Vertical"
    Color="0.92f, 0.92f, 0.92f">
    <Button HorizontalAlignment="Start" Click="loadModelButton_Click">
        <TextBlock Text="Load Model"/>
    </Button>
    <Button HorizontalAlignment="Start">
        <TextBlock Text="Save Scene"/>
    </Button>
</StackPanel>